# CU Platform — environment template
# Copy to .env and adjust for local development. Never commit real secrets.

# --- General ---
CU_ENV=development
CU_LOG_LEVEL=INFO
CU_API_PREFIX=/api/v1

# --- PostgreSQL ---
POSTGRES_USER=cu
POSTGRES_PASSWORD=cu_dev_password_change_me
POSTGRES_DB=cu
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Local default uses SQLite. For Compose/Postgres:
# DATABASE_URL=postgresql+asyncpg://cu:cu_dev_password_change_me@localhost:5432/cu
DATABASE_URL=sqlite+aiosqlite:///./apps/api/data/cu.db
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123!

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- MinIO / S3 ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_BUCKET=cu-monitoring
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me

# --- API ---
# Local default 8000. VPS production: 4000 (see docs/DEPLOYMENT.md)
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# --- Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
DASHBOARD_PORT=3000

# --- Agent ---
CU_API_BASE_URL=http://localhost:8000/api/v1
CU_MOCK_SCREENSHOTS=true

# --- Retention ---
DEFAULT_RETENTION_DAYS=15

# --- Nginx (compose) ---
DOMAIN=localhost
